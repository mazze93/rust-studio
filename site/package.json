{
  "name": "rust-studio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "verify": "cargo run --quiet --locked --manifest-path ../Cargo.toml -p studio-verify -- check",
    "verify:write": "cargo run --quiet --locked --manifest-path ../Cargo.toml -p studio-verify -- write",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "wrangler dev",
    "deploy:dry": "astro build && wrangler deploy --dry-run",
    "deploy": "npm run verify && astro check && astro build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
